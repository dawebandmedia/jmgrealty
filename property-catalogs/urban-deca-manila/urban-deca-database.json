  "issues": [
    {
      "topic": "Price validity",
      "detail": "Unit and parking computations are dated February-June 2026, with reservation deadlines through September 2026. December 2026 takeout headlines do not revive expired reservation terms. Historical figures only."
    },
    {
      "topic": "Missing unit prices",
      "detail": "Studio and 1 Bedroom have no matching supplied price computations; both remain on inquiry."
    },
    {
      "topic": "Missing exact plans",
      "detail": "2 Bedroom C and D have photo flyers and sample computations but no separately located internal unit layout. Do not substitute A/B plans."
    },
    {
      "topic": "Turnover inclusions",
      "detail": "Photo flyers advertise 1hp standard AC; website lists provision for air conditioning. Written confirmation required."
    },
    {
      "topic": "Bathrooms",
      "detail": "The four published unit plans show one toilet/bath. C and D counts are unverified and omitted rather than inferred."
    },
    {
      "topic": "Site plan currency",
      "detail": "Supplied site diagram carries finished/ongoing building colors and is undated. It is historical design context, not current availability or construction proof."
    },
    {
      "topic": "Parking",
      "detail": "Separate optional parking references do not establish allocation or inclusion in residential unit prices."
    },
    {
      "topic": "Media attribution",
      "detail": "Supplied photographs and flyers carry ANAYA Realty Services watermarks, retained unchanged. Confirm redistribution rights with the supplier."
    },
    {
      "topic": "Requirements",
      "detail": "Generic bank and applicant checklists are included as dated/undated references. Do not collect private borrower documents through the public inquiry form."
    }
